{
  "name": "@foodgrid/analytics-service",
  "version": "0.1.0",
  "private": true,
  "description": "Event-sourced analytics: GMV, revenue, orders, retention cohorts, restaurant profitability, supplier sales and rider performance.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test --no-error-on-unmatched-pattern",
    "test": "jest",
    "test:integration": "jest -c jest.integration.config.js --runInBand",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@foodgrid/auth": "workspace:*",
    "@foodgrid/database": "workspace:*",
    "@foodgrid/types": "workspace:*",
    "@foodgrid/utils": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "nestjs-pino": "^4.4.1",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "typescript": "~5.9.3"
  }
}
