{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm turbo run build --filter=@foodgrid/supplier-service...",
    "watchPatterns": [
      "services/supplier-service/**",
      "packages/**",
      "pnpm-lock.yaml",
      "infrastructure/railway/supplier-service.json"
    ]
  },
  "deploy": {
    "preDeployCommand": [
      "pnpm --filter @foodgrid/database db:deploy"
    ],
    "startCommand": "env NODE_ENV=production node services/supplier-service/dist/main.js",
    "healthcheckPath": "/health/ready",
    "restartPolicyType": "ON_FAILURE"
  }
}
