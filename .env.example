# ─── Core infrastructure ────────────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL=postgresql://foodgrid:foodgrid@localhost:5432/foodgrid?schema=public
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info

# ─── Auth ───────────────────────────────────────────────────────────────────
# RS256 key pair (base64-encoded PEM). Generate with: pnpm keys:generate
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_ISSUER=https://auth.foodgrid.local
JWT_AUDIENCE=foodgrid-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
# Shared secret for service-to-service (internal) tokens
INTERNAL_SERVICE_SECRET=change-me-internal-secret
# HMAC pepper for OTP hashing
OTP_SECRET=change-me-otp-secret
# Return OTP in the API response (never enable in production)
OTP_EXPOSE_IN_RESPONSE=true
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com

# ─── Payments (Razorpay) ─────────────────────────────────────────────────────
# Leave empty to use the built-in sandbox gateway for local development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PLATFORM_GSTIN=29AAACF0000A1ZP
PLATFORM_STATE_CODE=29

# ─── AWS ────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
S3_MEDIA_BUCKET=foodgrid-media-local
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
CDN_BASE_URL=http://localhost:9000/foodgrid-media-local

# ─── Notifications ──────────────────────────────────────────────────────────
SMS_PROVIDER=console          # console | sns | msg91
PUSH_PROVIDER=console         # console | fcm
EMAIL_PROVIDER=console        # console | ses
FCM_SERVICE_ACCOUNT_BASE64=
# MSG91: a flow linked to your DLT-approved login template, with variables ##code## and ##minutes##
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# SNS to India: sender id and DLT entity + template ids
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=
SMS_DLT_TEMPLATE_ID=
SES_FROM_ADDRESS=no-reply@foodgrid.in
# SES region and keys, only when the AWS_* values above belong to other S3-compatible storage
# (e.g. Cloudflare R2); empty = AWS_REGION and the default AWS credential chain
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# ─── External signals (AI) ──────────────────────────────────────────────────
# OpenWeather API key (free tier is enough: 5-day forecast, one call per city every
# 3 hours). ai-service stores rain and heat signals for the cities with active outlets
# and demand forecasts apply them; left empty, forecasts run without weather.
OPENWEATHER_API_KEY=

# ─── Service discovery (local defaults) ─────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:4001
USER_SERVICE_URL=http://localhost:4002
ORDER_SERVICE_URL=http://localhost:4003
PAYMENT_SERVICE_URL=http://localhost:4004
INVENTORY_SERVICE_URL=http://localhost:4005
PROCUREMENT_SERVICE_URL=http://localhost:4006
DELIVERY_SERVICE_URL=http://localhost:4007
SUPPLIER_SERVICE_URL=http://localhost:4008
ANALYTICS_SERVICE_URL=http://localhost:4009
ADS_SERVICE_URL=http://localhost:4010
NOTIFICATION_SERVICE_URL=http://localhost:4011
AI_SERVICE_URL=http://localhost:4012

# ─── Web apps (read at runtime by each Next.js server) ──────────────────────
# Gateway the /api/proxy and /api/auth routes forward to; browsers never call it directly.
API_URL=http://localhost:8080/api/v1
# vendor-web (business.) only links to the two seller portals
FOOD_SELLER_PORTAL_URL=http://localhost:3002
PRODUCT_SELLER_PORTAL_URL=http://localhost:3003
# Google Identity Services web client id for "Continue with Google" on customer-web, rider-web,
# restaurant-web and supplier-web.
# Must also be listed in GOOGLE_CLIENT_IDS above. Leave empty to hide the button.
GOOGLE_WEB_CLIENT_ID=
# City the customer site opens in, built into its pages: prayagraj (default, the launch city)
# or bengaluru (where the demo data is). Next.js reads it when building or starting the app.
NEXT_PUBLIC_CITY=bengaluru
