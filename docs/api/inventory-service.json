  "info": {
    "title": "FoodGrid Inventory Service",
    "description": "Ingredients, FEFO stock batches, stock ledger, consumption tracking, recipes, costing and production planning.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/",
      "description": "Gateway / local"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "service-token": {
        "type": "apiKey",
        "in": "header",
        "name": "x-service-token"
      }
    },
    "schemas": {
      "IngredientDto": {
        "type": "object",
        "properties": {
          "outletId": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "Maida (refined flour)"
          },
          "sku": {
            "type": "string",
            "example": "FLR-MAIDA"
          },
          "category": {
            "type": "string",
            "enum": [
              "FLOUR",
              "OIL",
              "SUGAR",
              "DAIRY",
              "VEGETABLES",
              "FRUITS",
              "PACKAGING",
              "SPICES",
              "GRAINS",
              "PULSES",
              "MEAT_SEAFOOD",
              "BEVERAGES",
              "FROZEN",
              "BAKERY",
              "CONDIMENTS",
              "OTHER"
            ]
          },
          "unit": {
            "type": "string",
            "enum": [
              "KG",
              "G",
              "L",
              "ML",
              "PCS",
              "PACK",
              "DOZEN",
              "BOX"
            ]
          },
          "reorderLevel": {
            "type": "number"
          },
          "reorderQty": {
            "type": "number"
          },
          "safetyStock": {
            "type": "number"
          },
          "maxStock": {
            "type": "number"
          },
          "shelfLifeDays": {
            "type": "number"
          },
          "storageType": {
            "type": "string",
            "enum": [
              "DRY",
              "CHILLED",
              "FROZEN"
            ]
          },
          "isPerishable": {
            "type": "boolean"
          },
          "leadTimeDays": {
            "type": "number"
          },
          "marketplaceCategory": {
            "type": "string",
            "description": "Marketplace category code for supplier matching (e.g. FLOUR, DAIRY)"
          },
          "preferredSupplierId": {
            "type": "string"
          },
          "marketplaceProductId": {
            "type": "string"
          },
          "openingStock": {
            "type": "number",
            "description": "Opening stock (creates an OPENING movement)"
          },
          "openingUnitCost": {
            "type": "number"
          }
        },
        "required": [
          "outletId",
          "name",
          "sku",
          "category",
          "unit"
        ]
      },
      "UpdateIngredientDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Maida (refined flour)"
          },
          "sku": {
            "type": "string",
            "example": "FLR-MAIDA"
          },
          "category": {
            "type": "string",
            "enum": [
              "FLOUR",
              "OIL",
              "SUGAR",
              "DAIRY",
              "VEGETABLES",
              "FRUITS",
              "PACKAGING",
              "SPICES",
              "GRAINS",
              "PULSES",
              "MEAT_SEAFOOD",
              "BEVERAGES",
              "FROZEN",
              "BAKERY",
              "CONDIMENTS",
              "OTHER"
            ]
          },
          "unit": {
            "type": "string",
            "enum": [
              "KG",
              "G",
              "L",
              "ML",
              "PCS",
              "PACK",
              "DOZEN",
              "BOX"
            ]
          },
          "reorderLevel": {
            "type": "number"
          },
          "reorderQty": {
            "type": "number"
          },
          "safetyStock": {
            "type": "number"
          },
          "maxStock": {
            "type": "number"
          },
          "shelfLifeDays": {
            "type": "number"
          },
          "storageType": {
            "type": "string",
            "enum": [
              "DRY",
              "CHILLED",
              "FROZEN"
            ]
          },
          "isPerishable": {
            "type": "boolean"
          },
          "leadTimeDays": {
            "type": "number"
          },
          "marketplaceCategory": {
            "type": "string",
            "description": "Marketplace category code for supplier matching (e.g. FLOUR, DAIRY)"
          },
          "preferredSupplierId": {
            "type": "string"
          },
          "marketplaceProductId": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "ReceiveLineDto": {
        "type": "object",
        "properties": {
          "ingredientId": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unitCost": {
            "type": "number",
            "description": "Cost per stock unit (pre-tax)"
          },
          "batchNumber": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          }
        },
        "required": [
          "ingredientId",
          "quantity",
          "unitCost"
        ]
      },
      "ReceiveStockDto": {
        "type": "object",
        "properties": {
          "outletId": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReceiveLineDto"
            }
          },
          "purchaseOrderId": {
            "type": "string"
          },
          "supplierTenantId": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "outletId",
          "lines"
        ]
      },
      "AdjustStockDto": {
        "type": "object",
        "properties": {
          "ingredientId": {
            "type": "string"
          },
          "countedQuantity": {
            "type": "number",
            "description": "Physically counted quantity"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "ingredientId",
          "countedQuantity",
          "reason"
        ]
      },
      "WastageDto": {
        "type": "object",
        "properties": {
          "ingredientId": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "reason": {
            "type": "string",
            "example": "Spoiled — fridge failure"
          }
        },
        "required": [
          "ingredientId",
          "quantity",
          "reason"
        ]
      },
      "RecipeLineDto": {
        "type": "object",
        "properties": {
          "ingredientId": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "example": 150
          },
          "unit": {
            "type": "string",
            "enum": [
              "KG",
              "G",
              "L",
              "ML",
              "PCS",
              "PACK",
              "DOZEN",
              "BOX"
            ],
            "example": "G"
          },
          "wastagePct": {
            "type": "number",
            "example": 5
          }
        },
        "required": [
          "ingredientId",
          "quantity",
          "unit"
        ]
      },
      "RecipeDto": {
        "type": "object",
        "properties": {
          "outletId": {
            "type": "string"
          },
          "menuItemId": {
            "type": "string",
            "description": "Menu item this recipe produces"
          },
          "name": {
            "type": "string"
          },
          "yieldQty": {
            "type": "number",
            "default": 1,
            "description": "Portions produced by the quantities below"
          },
          "prepTimeMins": {
            "type": "number"
          },
          "instructions": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecipeLineDto"
            }
          }
        },
        "required": [
          "outletId",
          "menuItemId",
          "name",
          "lines"
        ]
      },
      "GeneratePlanDto": {
        "type": "object",
        "properties": {
          "outletId": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "example": "2026-10-07"
          },
          "bufferPct": {
            "type": "number",
            "default": 10,
            "description": "Safety buffer %"
          }
        },
        "required": [
          "outletId",
          "date"
        ]
      },
      "UpdatePlanItemDto": {
        "type": "object",
        "properties": {
          "plannedQty": {
            "type": "number"
          },
          "producedQty": {
            "type": "number"
          }
        }
      }
    }
  }
}
