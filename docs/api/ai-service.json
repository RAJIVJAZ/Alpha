  "info": {
    "title": "FoodGrid AI Service",
    "description": "Demand forecasting, dynamic pricing, inventory optimisation, supplier recommendation, fraud detection, route optimisation, recommendations and outlet scoring.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/",
      "description": "Gateway / local"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "service-token": {
        "type": "apiKey",
        "in": "header",
        "name": "x-service-token"
      }
    },
    "schemas": {
      "SeriesPointDto": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "value": {
            "type": "number"
          }
        },
        "required": [
          "date",
          "value"
        ]
      },
      "DemandForecastDto": {
        "type": "object",
        "properties": {
          "series": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SeriesPointDto"
            }
          },
          "horizonDays": {
            "type": "number",
            "minimum": 1,
            "maximum": 90
          },
          "category": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "currentStock": {
            "type": "number",
            "description": "If set, the response includes depletion prediction"
          },
          "tenantId": {
            "type": "string"
          }
        },
        "required": [
          "series",
          "horizonDays"
        ]
      },
      "InventoryOptimizeDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "serviceLevel": {
            "type": "number",
            "default": 0.95
          },
          "reviewPeriodDays": {
            "type": "number",
            "default": 7
          },
          "tenantId": {
            "type": "string"
          }
        },
        "required": [
          "items"
        ]
      },
      "RankSuppliersDto": {
        "type": "object",
        "properties": {
          "offers": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "quantity": {
            "type": "number"
          },
          "strategy": {
            "type": "string",
            "enum": [
              "LOWEST_COST",
              "FASTEST",
              "BEST_RATED",
              "BALANCED"
            ]
          },
          "tenantId": {
            "type": "string"
          }
        },
        "required": [
          "offers",
          "quantity",
          "strategy"
        ]
      },
      "SurgeDto": {
        "type": "object",
        "properties": {
          "pendingOrders": {
            "type": "number"
          },
          "onlineRiders": {
            "type": "number"
          },
          "rainMm": {
            "type": "number"
          },
          "hourOfDay": {
            "type": "number"
          },
          "isFestival": {
            "type": "boolean"
          }
        },
        "required": [
          "pendingOrders",
          "onlineRiders",
          "hourOfDay"
        ]
      },
      "MarkdownDto": {
        "type": "object",
        "properties": {
          "products": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "products"
        ]
      },
      "FraudScoreDto": {
        "type": "object",
        "properties": {
          "entityType": {
            "type": "string",
            "enum": [
              "ORDER",
              "PAYMENT",
              "USER",
              "RIDER",
              "COUPON_REDEMPTION",
              "REFUND"
            ]
          },
          "entityId": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "features": {
            "type": "object"
          }
        },
        "required": [
          "entityType",
          "entityId",
          "features"
        ]
      },
      "TrajectoryDto": {
        "type": "object",
        "properties": {
          "riderId": {
            "type": "string"
          },
          "deliveryId": {
            "type": "string"
          },
          "pings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "drop": {
            "type": "object"
          }
        },
        "required": [
          "riderId",
          "deliveryId",
          "pings"
        ]
      },
      "RouteDto": {
        "type": "object",
        "properties": {
          "start": {
            "type": "object"
          },
          "stops": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "avgSpeedKmph": {
            "type": "number"
          }
        },
        "required": [
          "start",
          "stops"
        ]
      },
      "OutletRecoDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "context": {
            "type": "object"
          }
        },
        "required": [
          "history",
          "candidates"
        ]
      },
      "ItemRecoDto": {
        "type": "object",
        "properties": {
          "baskets": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "seedItemIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limit": {
            "type": "number"
          }
        },
        "required": [
          "baskets",
          "seedItemIds"
        ]
      },
      "OutletScoreDto": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "outletId": {
            "type": "string"
          },
          "periodStart": {
            "type": "string"
          },
          "periodEnd": {
            "type": "string"
          },
          "metrics": {
            "type": "object"
          }
        },
        "required": [
          "tenantId",
          "outletId",
          "periodStart",
          "periodEnd",
          "metrics"
        ]
      },
      "ReviewFraudDto": {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "CONFIRMED_FRAUD",
              "FALSE_POSITIVE"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "SignalDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "FESTIVAL",
              "WEATHER",
              "EVENT",
              "HOLIDAY"
            ]
          },
          "name": {
            "type": "string",
            "example": "Diwali"
          },
          "city": {
            "type": "string",
            "description": "Null = nationwide"
          },
          "date": {
            "type": "string"
          },
          "impact": {
            "type": "number",
            "example": 1.4
          },
          "categories": {
            "example": [
              "SUGAR",
              "DAIRY",
              "FLOUR"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "type",
          "name",
          "date",
          "impact"
        ]
      }
    }
  }
}
