  "info": {
    "title": "FoodGrid Notification Service",
    "description": "Push (FCM), SMS, email and in-app notifications, templates, device tokens, push campaigns.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/",
      "description": "Gateway / local"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "service-token": {
        "type": "apiKey",
        "in": "header",
        "name": "x-service-token"
      }
    },
    "schemas": {
      "RegisterDeviceDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "platform": {
            "type": "string",
            "enum": [
              "ANDROID",
              "IOS",
              "WEB"
            ]
          },
          "app": {
            "type": "string",
            "enum": [
              "CUSTOMER",
              "RIDER",
              "MERCHANT",
              "ADMIN"
            ]
          }
        },
        "required": [
          "token",
          "platform",
          "app"
        ]
      },
      "PreferencesDto": {
        "type": "object",
        "properties": {
          "pushEnabled": {
            "type": "boolean"
          },
          "smsEnabled": {
            "type": "boolean"
          },
          "emailEnabled": {
            "type": "boolean"
          },
          "marketingEnabled": {
            "type": "boolean"
          },
          "quietHoursStart": {
            "type": "string",
            "example": "22:00"
          },
          "quietHoursEnd": {
            "type": "string",
            "example": "08:00"
          }
        }
      },
      "TemplateDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "example": "order.accepted"
          },
          "channel": {
            "type": "string",
            "enum": [
              "PUSH",
              "SMS",
              "EMAIL",
              "IN_APP",
              "WHATSAPP"
            ]
          },
          "locale": {
            "type": "string",
            "default": "en"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "channel",
          "body"
        ]
      },
      "InternalSendDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "recipient": {
            "type": "string"
          },
          "channel": {
            "type": "string",
            "enum": [
              "PUSH",
              "SMS",
              "EMAIL",
              "IN_APP",
              "WHATSAPP"
            ]
          },
          "app": {
            "type": "string",
            "enum": [
              "CUSTOMER",
              "RIDER",
              "MERCHANT",
              "ADMIN"
            ]
          },
          "templateKey": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "data": {
            "type": "object"
          },
          "tenantId": {
            "type": "string"
          }
        },
        "required": [
          "channel"
        ]
      },
      "InternalSmsDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string"
          },
          "templateKey": {
            "type": "string"
          },
          "data": {
            "type": "object"
          }
        },
        "required": [
          "phone",
          "templateKey"
        ]
      },
      "PushCampaignDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "imageUrl": {
            "type": "string"
          },
          "deepLink": {
            "type": "string",
            "example": "foodgrid://outlets/spice-route"
          },
          "app": {
            "type": "string",
            "enum": [
              "CUSTOMER",
              "RIDER",
              "MERCHANT",
              "ADMIN"
            ]
          },
          "userIds": {
            "description": "Explicit user ids (default: everyone with the app installed)",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scheduledAt": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "body",
          "app"
        ]
      }
    }
  }
}
