        "bearerFormat": "JWT",
        "type": "http"
      },
      "service-token": {
        "type": "apiKey",
        "in": "header",
        "name": "x-service-token"
      }
    },
    "schemas": {
      "RiderDocumentDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "example": "DRIVING_LICENSE"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "url"
        ]
      },
      "RiderOnboardingDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "city": {
            "type": "string",
            "example": "Bengaluru"
          },
          "vehicleType": {
            "type": "string",
            "enum": [
              "BICYCLE",
              "SCOOTER",
              "MOTORCYCLE",
              "EV_SCOOTER"
            ]
          },
          "vehicleNumber": {
            "type": "string",
            "example": "KA01AB1234"
          },
          "licenseNumber": {
            "type": "string"
          },
          "aadhaarLast4": {
            "type": "string"
          },
          "upiId": {
            "type": "string",
            "example": "rider@okaxis"
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RiderDocumentDto"
            }
          }
        },
        "required": [
          "name",
          "city",
          "vehicleType"
        ]
      },
      "LocationPingDto": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "accuracyM": {
            "type": "number"
          },
          "speedKmph": {
            "type": "number"
          },
          "heading": {
            "type": "number"
          },
          "batteryPct": {
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lng"
        ]
      },
      "RejectOfferDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "example": "Too far"
          }
        }
      },
      "CompleteDeliveryDto": {
        "type": "object",
        "properties": {
          "otp": {
            "type": "string",
            "description": "4-digit OTP shown in the customer app"
          },
          "proofPhotoUrl": {
            "type": "string",
            "description": "Proof photo (required for contact-less drops without OTP)"
          },
          "proofSignatureUrl": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "codCollected": {
            "type": "boolean",
            "description": "Cash collected for COD orders"
          }
        }
      },
      "FailDeliveryDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "example": "Customer unreachable"
          },
          "proofPhotoUrl": {
            "type": "string"
          }
        },
        "required": [
          "reason"
        ]
      },
      "AdminRiderStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED",
              "OFFBOARDED"
            ]
          },
          "zoneId": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "ReassignDto": {
        "type": "object",
        "properties": {
          "riderId": {
            "type": "string"
          }
        },
        "required": [
          "riderId"
        ]
      },
      "IncentiveSchemeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Weekend warrior: 40 orders"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "ORDER_COUNT",
              "PEAK_HOURS",
              "LOGIN_HOURS",
              "STREAK",
              "RATING"
            ]
          },
          "zoneId": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "target": {
            "type": "number",
            "example": 40
          },
          "rewardAmount": {
            "type": "number",
            "example": 600
          },
          "peakWindows": {
            "example": [
              {
                "start": "12:00",
                "end": "14:30"
              }
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "minRating": {
            "type": "number"
          },
          "startsAt": {
            "type": "string"
          },
          "endsAt": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "type",
          "target",
          "rewardAmount",
          "startsAt",
          "endsAt"
        ]
      },
      "UpdateIncentiveSchemeDto": {
        "type": "object",
        "properties": {
