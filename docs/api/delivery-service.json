          },
          "rewardAmount": {
            "type": "number",
            "example": 600
          },
          "peakWindows": {
            "example": [
              {
                "start": "12:00",
                "end": "14:30"
              }
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "minRating": {
            "type": "number"
          },
          "startsAt": {
            "type": "string"
          },
          "endsAt": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "DeliveryZoneDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Indiranagar"
          },
          "city": {
            "type": "string",
            "example": "Bengaluru"
          },
          "polygon": {
            "type": "array",
            "description": "GeoJSON polygon ring: [[lng, lat], ...]",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "centerLat": {
            "type": "number"
          },
          "centerLng": {
            "type": "number"
          },
          "baseFee": {
            "type": "number",
            "example": 25
          },
          "perKmFee": {
            "type": "number",
            "example": 8
          },
          "freeKm": {
            "type": "number",
            "example": 2
          },
          "surgeMultiplier": {
            "type": "number",
            "example": 1
          },
          "riderBasePay": {
            "type": "number",
            "example": 30
          },
          "riderPerKm": {
            "type": "number",
            "example": 6
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "city",
          "polygon",
          "centerLat",
          "centerLng",
          "baseFee",
          "perKmFee",
          "riderBasePay",
          "riderPerKm"
        ]
      },
      "UpdateDeliveryZoneDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Indiranagar"
          },
          "city": {
            "type": "string",
            "example": "Bengaluru"
          },
          "polygon": {
            "type": "array",
            "description": "GeoJSON polygon ring: [[lng, lat], ...]",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "centerLat": {
            "type": "number"
          },
          "centerLng": {
            "type": "number"
          },
          "baseFee": {
            "type": "number",
            "example": 25
          },
          "perKmFee": {
            "type": "number",
            "example": 8
          },
          "freeKm": {
            "type": "number",
            "example": 2
          },
          "surgeMultiplier": {
            "type": "number",
            "example": 1
          },
          "riderBasePay": {
            "type": "number",
            "example": 30
          },
          "riderPerKm": {
            "type": "number",
            "example": 6
          },
          "isActive": {
