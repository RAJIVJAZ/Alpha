{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/otp/request": {
      "post": {
        "operationId": "Auth_requestOtp",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestOtpDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Send a 6-digit login OTP by SMS (rate limited)",
        "tags": [
          "auth"
        ],
        "security": []
      }
    },
    "/api/v1/auth/otp/verify": {
      "post": {
        "operationId": "Auth_verifyOtp",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyOtpDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Verify OTP; signs up new users automatically and returns tokens",
        "tags": [
          "auth"
        ],
        "security": []
      }
    },
    "/api/v1/auth/google": {
      "post": {
        "operationId": "Auth_google",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleLoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Log in with a Google ID token",
        "tags": [
          "auth"
        ],
        "security": []
      }
    },
    "/api/v1/auth/password": {
      "post": {
        "operationId": "Auth_password",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordLoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Email + password login (back-office and merchant staff)",
        "tags": [
          "auth"
        ],
        "security": []
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "Auth_refresh",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Rotate the refresh token and obtain a new access token",
        "tags": [
          "auth"
        ],
        "security": []
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "Auth_logout",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "Revoke the session behind a refresh token",
        "tags": [
          "auth"
        ],
        "security": []
      }
    },
    "/api/v1/auth/switch-tenant": {
      "post": {
        "operationId": "Auth_switchTenant",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SwitchTenantDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Select the active business (tenant) for merchant dashboards",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "Auth_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Current user with business memberships",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/sessions": {
      "get": {
        "operationId": "Auth_listSessions",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Active login sessions / devices",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/sessions/{sessionId}": {
      "delete": {
        "operationId": "Auth_revokeSession",
        "parameters": [
          {
            "name": "sessionId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/internal/auth/revoke-user-sessions": {
      "post": {
        "operationId": "InternalAuth_revokeUser",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RevokeUserSessionsDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Revoke every session of a user (e.g. account blocked)",
        "tags": [
          "internal"
        ],
        "security": [
          {
            "service-token": []
          }
        ]
      }
    },
    "/.well-known/jwks.json": {
      "get": {
        "operationId": "Jwks_jwks",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Public signing keys (JWKS) for access-token verification",
        "tags": [
          "auth"
        ],
        "security": []
      }
    }
  },
  "info": {
    "title": "FoodGrid Auth Service",
    "description": "OTP, Google and password login; JWT access/refresh token lifecycle; tenant switching; JWKS.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/",
      "description": "Gateway / local"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "service-token": {
        "type": "apiKey",
        "in": "header",
        "name": "x-service-token"
      }
    },
    "schemas": {
      "RequestOtpDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "9876543210",
            "description": "10-digit Indian mobile or E.164 number"
          }
        },
        "required": [
          "phone"
        ]
      },
      "VerifyOtpDto": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "description": "Stable device identifier (used for fraud signals)"
          },
          "phone": {
            "type": "string",
            "example": "9876543210"
          },
          "code": {
            "type": "string",
            "example": "123456"
          },
          "referralCode": {
            "type": "string",
            "description": "Referral code of the inviting user (new sign-ups only)"
          }
        },
        "required": [
          "phone",
          "code"
        ]
      },
      "GoogleLoginDto": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "description": "Stable device identifier (used for fraud signals)"
          },
          "idToken": {
            "type": "string",
            "description": "Google ID token from Google Identity Services / google_sign_in"
          }
        },
        "required": [
          "idToken"
        ]
      },
      "PasswordLoginDto": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "description": "Stable device identifier (used for fraud signals)"
          },
          "email": {
            "type": "string",
            "example": "admin@foodgrid.in"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "SwitchTenantDto": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "object",
            "description": "Tenant to activate; omit/null to clear the business context",
            "nullable": true
          }
        }
      },
      "RevokeUserSessionsDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          }
        },
        "required": [
          "userId"
        ]
      }
    }
  }
}
