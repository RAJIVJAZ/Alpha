  "info": {
    "title": "FoodGrid Procurement Service",
    "description": "Smart procurement engine: demand forecasts, depletion prediction, reorder alerts, supplier comparison, auto purchase orders, approvals and PO tracking.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/",
      "description": "Gateway / local"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "service-token": {
        "type": "apiKey",
        "in": "header",
        "name": "x-service-token"
      }
    },
    "schemas": {
      "SettingsDto": {
        "type": "object",
        "properties": {
          "autoPoEnabled": {
            "type": "boolean"
          },
          "autoApproveBelow": {
            "type": "number",
            "description": "Auto-generated POs up to this total skip owner approval"
          },
          "defaultStrategy": {
            "type": "string",
            "enum": [
              "LOWEST_COST",
              "FASTEST",
              "BEST_RATED",
              "BALANCED"
            ]
          },
          "forecastHorizonDays": {
            "type": "number"
          },
          "serviceLevel": {
            "type": "number"
          },
          "reviewPeriodDays": {
            "type": "number"
          }
        }
      },
      "AutoPoDto": {
        "type": "object",
        "properties": {
          "alertIds": {
            "description": "Alerts to act on (default: all open alerts)",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "strategy": {
            "type": "string",
            "enum": [
              "LOWEST_COST",
              "FASTEST",
              "BEST_RATED",
              "BALANCED"
            ]
          }
        }
      },
      "PoLineDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "ingredientId": {
            "type": "string",
            "description": "Ingredient this product restocks"
          },
          "quantity": {
            "type": "number",
            "description": "Packs to order"
          }
        },
        "required": [
          "productId",
          "quantity"
        ]
      },
      "CreatePoDto": {
        "type": "object",
        "properties": {
          "outletId": {
            "type": "string"
          },
          "supplierTenantId": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PoLineDto"
            }
          },
          "notes": {
            "type": "string"
          },
          "paymentTerms": {
            "type": "string",
            "enum": [
              "PREPAID",
              "COD",
              "NET_7",
              "NET_15",
              "NET_30"
            ]
          }
        },
        "required": [
          "outletId",
          "supplierTenantId",
          "items"
        ]
      },
      "DecisionDto": {
        "type": "object",
        "properties": {
          "comment": {
            "type": "string"
          }
        }
      },
      "ReceiveLineDto": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string"
          },
          "receivedQty": {
            "type": "number",
            "description": "Packs received in good condition"
          }
        },
        "required": [
          "itemId",
          "receivedQty"
        ]
      },
      "ReceivePoDto": {
        "type": "object",
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReceiveLineDto"
            }
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "lines"
        ]
      }
    }
  }
}
