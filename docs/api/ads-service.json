  "info": {
    "title": "FoodGrid Ads Service",
    "description": "Sponsored listings: campaigns, auctions, budget pacing, impression/click/conversion tracking.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/",
      "description": "Gateway / local"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "service-token": {
        "type": "apiKey",
        "in": "header",
        "name": "x-service-token"
      }
    },
    "schemas": {
      "CampaignDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "placement": {
            "type": "string",
            "enum": [
              "SEARCH_TOP",
              "HOME_CAROUSEL",
              "CATEGORY_TOP",
              "MARKETPLACE_TOP",
              "MENU_HIGHLIGHT"
            ]
          },
          "targetType": {
            "type": "string",
            "enum": [
              "OUTLET",
              "MENU_ITEM",
              "PRODUCT"
            ]
          },
          "targetId": {
            "type": "string"
          },
          "bidType": {
            "type": "string",
            "enum": [
              "CPC",
              "CPM"
            ]
          },
          "bidAmount": {
            "type": "number",
            "example": 6
          },
          "dailyBudget": {
            "type": "number",
            "example": 500
          },
          "totalBudget": {
            "type": "number",
            "example": 10000
          },
          "keywords": {
            "example": [
              "biryani",
              "hyderabadi"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cities": {
            "example": [
              "Bengaluru"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "startsAt": {
            "type": "string"
          },
          "endsAt": {
            "type": "string"
          },
          "creative": {
            "type": "object",
            "example": {
              "title": "20% off on biryanis",
              "imageUrl": "https://…",
              "cta": "Order now"
            }
          }
        },
        "required": [
          "name",
          "placement",
          "targetType",
          "targetId",
          "bidAmount",
          "dailyBudget",
          "totalBudget",
          "startsAt"
        ]
      },
      "UpdateCampaignDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "placement": {
            "type": "string",
            "enum": [
              "SEARCH_TOP",
              "HOME_CAROUSEL",
              "CATEGORY_TOP",
              "MARKETPLACE_TOP",
              "MENU_HIGHLIGHT"
            ]
          },
          "targetType": {
            "type": "string",
            "enum": [
              "OUTLET",
              "MENU_ITEM",
              "PRODUCT"
            ]
          },
          "targetId": {
            "type": "string"
          },
          "bidType": {
            "type": "string",
            "enum": [
              "CPC",
              "CPM"
            ]
          },
          "bidAmount": {
            "type": "number",
            "example": 6
          },
          "dailyBudget": {
            "type": "number",
            "example": 500
          },
          "totalBudget": {
            "type": "number",
            "example": 10000
          },
          "keywords": {
            "example": [
              "biryani",
              "hyderabadi"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cities": {
            "example": [
              "Bengaluru"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "startsAt": {
            "type": "string"
          },
          "endsAt": {
            "type": "string"
          },
          "creative": {
            "type": "object",
            "example": {
              "title": "20% off on biryanis",
              "imageUrl": "https://…",
              "cta": "Order now"
            }
          }
        }
      },
      "ClickDto": {
        "type": "object",
        "properties": {
          "campaignId": {
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          }
        },
        "required": [
          "campaignId"
        ]
      },
      "ServeDto": {
        "type": "object",
        "properties": {
          "placement": {
            "type": "string",
            "enum": [
              "SEARCH_TOP",
              "HOME_CAROUSEL",
              "CATEGORY_TOP",
              "MARKETPLACE_TOP",
              "MENU_HIGHLIGHT"
            ]
          },
          "city": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limit": {
            "type": "number"
          },
          "userId": {
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          }
        },
        "required": [
          "placement"
        ]
      }
    }
  }
}
