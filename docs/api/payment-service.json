      }
    },
    "/api/v1/internal/payments/wallets/credit": {
      "post": {
        "operationId": "Internal_credit",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InternalCreditDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": [
          "internal"
        ],
        "security": [
          {
            "service-token": []
          }
        ]
      }
    }
  },
  "info": {
    "title": "FoodGrid Payment Service",
    "description": "Razorpay/UPI/card payments, wallets & ledger, refunds, commissions, settlements, payouts, GST invoices & reports.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/",
      "description": "Gateway / local"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "service-token": {
        "type": "apiKey",
        "in": "header",
        "name": "x-service-token"
      }
    },
    "schemas": {
      "CreatePaymentIntentDto": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string",
            "enum": [
              "ORDER",
              "WALLET_TOPUP",
              "MEMBERSHIP",
              "MEAL_SUBSCRIPTION",
              "B2B_ORDER",
              "AD_CAMPAIGN"
            ]
          },
          "referenceId": {
            "type": "string",
            "description": "Order / membership / subscription / B2B order / campaign id (not for WALLET_TOPUP)"
          },
          "method": {
            "type": "string",
            "enum": [
              "UPI",
              "CARD",
              "NETBANKING",
              "WALLET"
            ],
            "description": "WALLET pays from FoodGrid wallet balance"
          },
          "amount": {
            "type": "number",
            "description": "Top-up amount (WALLET_TOPUP only)",
            "minimum": 10,
            "maximum": 10000
          }
        },
        "required": [
          "purpose",
          "method"
        ]
      },
      "VerifyPaymentDto": {
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "string"
          },
          "razorpayOrderId": {
            "type": "string"
          },
          "razorpayPaymentId": {
            "type": "string"
          },
          "razorpaySignature": {
            "type": "string"
          }
        },
        "required": [
          "paymentId",
          "razorpayOrderId",
          "razorpayPaymentId",
          "razorpaySignature"
        ]
      },
      "SandboxCompleteDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "method": {
            "type": "string",
            "enum": [
              "upi",
              "card",
              "netbanking"
            ]
          }
        },
        "required": [
          "success"
        ]
      },
      "RefundDto": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "description": "Defaults to the full refundable amount"
          },
          "reason": {
            "type": "string"
          },
          "toWallet": {
            "type": "boolean",
            "description": "Refund instantly to the FoodGrid wallet"
          }
        },
        "required": [
          "reason"
        ]
      },
      "PayoutRequestDto": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "minimum": 100
          },
          "method": {
            "type": "string",
            "enum": [
              "UPI",
              "BANK_TRANSFER"
            ]
          },
          "destination": {
            "type": "object",
            "example": {
              "upiId": "rider@okicici"
            }
          }
        },
        "required": [
          "amount",
          "method",
          "destination"
        ]
      },
      "MarkPayoutDto": {
        "type": "object",
        "properties": {
          "utr": {
            "type": "string",
            "description": "Bank UTR reference"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "CashDepositDto": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "description": "Cash the rider handed in (₹)"
          },
          "reference": {
            "type": "string",
            "description": "Hub receipt or bank deposit slip number"
          }
        },
        "required": [
          "amount"
        ]
      },
      "CommissionRuleDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "tenantType": {
            "type": "string",
            "enum": [
              "PLATFORM",
              "RESTAURANT",
              "FOOD_CART",
              "SUPPLIER",
              "WHOLESALER",
              "RETAILER"
            ]
          },
          "tenantId": {
            "type": "string"
          },
          "outletId": {
            "type": "string"
          },
          "ratePct": {
            "type": "number",
            "example": 18
          },
          "fixedFee": {
            "type": "number"
          },
          "minFee": {
            "type": "number"
          },
          "maxFee": {
            "type": "number"
          },
          "priority": {
            "type": "number"
          },
          "effectiveFrom": {
            "type": "string"
          },
          "effectiveTo": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "ratePct"
        ]
      },
      "UpdateCommissionRuleDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "tenantType": {
            "type": "string",
            "enum": [
              "PLATFORM",
              "RESTAURANT",
              "FOOD_CART",
              "SUPPLIER",
              "WHOLESALER",
              "RETAILER"
            ]
          },
          "tenantId": {
            "type": "string"
          },
          "outletId": {
            "type": "string"
          },
          "ratePct": {
            "type": "number",
            "example": 18
          },
          "fixedFee": {
            "type": "number"
          },
          "minFee": {
            "type": "number"
          },
          "maxFee": {
            "type": "number"
          },
          "priority": {
            "type": "number"
          },
          "effectiveFrom": {
            "type": "string"
          },
          "effectiveTo": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "RunSettlementDto": {
        "type": "object",
        "properties": {
          "periodStart": {
            "type": "string",
            "example": "2026-09-28"
          },
          "periodEnd": {
            "type": "string",
            "example": "2026-10-05",
            "description": "Exclusive"
          }
        },
        "required": [
          "periodStart",
          "periodEnd"
        ]
      },
      "MarkSettlementPaidDto": {
        "type": "object",
        "properties": {
          "payoutReference": {
            "type": "string"
          }
        },
        "required": [
          "payoutReference"
        ]
      },
      "InternalCreditDto": {
        "type": "object",
        "properties": {
          "ownerType": {
            "type": "string",
            "enum": [
              "CUSTOMER",
              "RIDER",
              "TENANT"
            ]
          },
          "ownerId": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "reason": {
            "type": "string",
            "enum": [
              "CASHBACK",
              "REFERRAL_BONUS",
              "ADJUSTMENT",
              "INCENTIVE"
            ]
          },
          "idempotencyKey": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "referenceType": {
            "type": "string"
          },
          "referenceId": {
            "type": "string"
          }
        },
        "required": [
          "ownerType",
          "ownerId",
          "amount",
          "reason",
          "idempotencyKey"
        ]
      }
    }
  }
}
