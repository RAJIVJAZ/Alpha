{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin-web": {
      "root": "apps/admin-web",
      "framework": "nextjs",
      "buildCommand": "cd ../.. && pnpm turbo run build --filter=@foodgrid/admin-web..."
    },
    "restaurant-web": {
      "root": "apps/restaurant-web",
      "framework": "nextjs",
      "buildCommand": "cd ../.. && pnpm turbo run build --filter=@foodgrid/restaurant-web..."
    },
    "vendor-web": {
      "root": "apps/vendor-web",
      "framework": "nextjs",
      "buildCommand": "cd ../.. && pnpm turbo run build --filter=@foodgrid/vendor-web..."
    },
    "supplier-web": {
      "root": "apps/supplier-web",
      "framework": "nextjs",
      "buildCommand": "cd ../.. && pnpm turbo run build --filter=@foodgrid/supplier-web..."
    },
    "rider-web": {
      "root": "apps/rider-web",
      "framework": "nextjs",
      "buildCommand": "cd ../.. && pnpm turbo run build --filter=@foodgrid/rider-web..."
    },
    "customer-web": {
      "root": "apps/customer-web",
      "framework": "nextjs",
      "buildCommand": "cd ../.. && pnpm turbo run build --filter=@foodgrid/customer-web..."
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "admin\\..+"
        }
      ],
      "destination": {
        "service": "admin-web"
      }
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "partner\\..+"
        }
      ],
      "destination": {
        "service": "restaurant-web"
      }
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "business\\..+"
        }
      ],
      "destination": {
        "service": "vendor-web"
      }
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "supplier\\..+"
        }
      ],
      "destination": {
        "service": "supplier-web"
      }
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "rider\\..+"
        }
      ],
      "destination": {
        "service": "rider-web"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "customer-web"
      }
    }
  ]
}
