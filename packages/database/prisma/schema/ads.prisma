// ─────────────────────────────────────────────────────────────────────────────
// ads: sponsored listings for outlets, dishes and marketplace products.
// Owned by ads-service.
// ─────────────────────────────────────────────────────────────────────────────

enum AdPlacement {
  SEARCH_TOP
  HOME_CAROUSEL
  CATEGORY_TOP
  MARKETPLACE_TOP
  MENU_HIGHLIGHT

  @@schema("ads")
}

enum AdTargetType {
  OUTLET
  MENU_ITEM
  PRODUCT

  @@schema("ads")
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  EXHAUSTED
  COMPLETED
  REJECTED

  @@schema("ads")
}

enum BidType {
  CPC
  CPM

  @@schema("ads")
}

enum AdEventType {
  IMPRESSION
  CLICK
  CONVERSION

  @@schema("ads")
}

model AdCampaign {
  id             String         @id @default(cuid())
  tenantId       String
  name           String
  placement      AdPlacement
  targetType     AdTargetType
  targetId       String
  status         CampaignStatus @default(DRAFT)
  bidType        BidType        @default(CPC)
  bidAmount      Decimal        @db.Decimal(10, 2)
  dailyBudget    Decimal        @db.Decimal(12, 2)
  totalBudget    Decimal        @db.Decimal(12, 2)
  spent          Decimal        @default(0) @db.Decimal(12, 2)
  spentToday     Decimal        @default(0) @db.Decimal(12, 2)
  spentTodayDate DateTime?      @db.Date
  keywords       String[]       @default([])
  cities         String[]       @default([])
  startsAt       DateTime
  endsAt         DateTime?
  /// { "title": "...", "imageUrl": "...", "cta": "Order now" }
  creative       Json           @default("{}")
  reviewedBy     String?
  reviewNotes    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  events     AdEvent[]
  dailyStats AdDailyStats[]

  @@index([status, placement])
  @@index([tenantId])
  @@schema("ads")
}

model AdEvent {
  id         String      @id @default(cuid())
  campaignId String
  type       AdEventType
  userId     String?
  sessionId  String?
  cost       Decimal     @default(0) @db.Decimal(10, 4)
  orderId    String?
  context    Json?
  createdAt  DateTime    @default(now())

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@schema("ads")
}

model AdDailyStats {
  id          String   @id @default(cuid())
  campaignId  String
  date        DateTime @db.Date
  impressions Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  spend       Decimal  @default(0) @db.Decimal(12, 2)
  revenue     Decimal  @default(0) @db.Decimal(14, 2)

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@schema("ads")
}
