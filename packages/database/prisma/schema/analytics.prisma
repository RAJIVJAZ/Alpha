// ─────────────────────────────────────────────────────────────────────────────
// analytics: event-sourced read models / fact tables for dashboards
// (GMV, revenue, retention, supplier sales, profitability, rider performance).
// Owned by analytics-service. Rebuildable from the event streams.
// ─────────────────────────────────────────────────────────────────────────────

model OrderFact {
  orderId         String    @id
  orderNumber     String
  date            DateTime  @db.Date
  hour            Int
  tenantId        String
  outletId        String
  outletType      String
  city            String?
  customerId      String?
  channel         String
  orderType       String
  status          String
  paymentMethod   String?
  itemsCount      Int
  gmv             Decimal   @db.Decimal(12, 2)
  subtotal        Decimal   @db.Decimal(12, 2)
  discount        Decimal   @db.Decimal(12, 2)
  deliveryFee     Decimal   @db.Decimal(12, 2)
  tax             Decimal   @db.Decimal(12, 2)
  commission      Decimal   @default(0) @db.Decimal(12, 2)
  platformRevenue Decimal   @default(0) @db.Decimal(12, 2)
  foodCost        Decimal   @default(0) @db.Decimal(12, 2)
  isFirstOrder    Boolean   @default(false)
  prepMins        Int?
  deliveryMins    Int?
  riderId         String?
  placedAt        DateTime
  deliveredAt     DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([date])
  @@index([tenantId, date])
  @@index([outletId, date])
  @@index([customerId, date])
  @@schema("analytics")
}

model DailyOutletStats {
  id              String   @id @default(cuid())
  date            DateTime @db.Date
  tenantId        String
  outletId        String
  orders          Int      @default(0)
  cancelledOrders Int      @default(0)
  gmv             Decimal  @default(0) @db.Decimal(14, 2)
  netSales        Decimal  @default(0) @db.Decimal(14, 2)
  discounts       Decimal  @default(0) @db.Decimal(14, 2)
  commission      Decimal  @default(0) @db.Decimal(14, 2)
  foodCost        Decimal  @default(0) @db.Decimal(14, 2)
  grossProfit     Decimal  @default(0) @db.Decimal(14, 2)
  avgPrepMins     Float?
  newCustomers    Int      @default(0)
  repeatCustomers Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@unique([outletId, date])
  @@index([tenantId, date])
  @@schema("analytics")
}

model DailyRiderStats {
  id              String   @id @default(cuid())
  date            DateTime @db.Date
  riderId         String
  deliveries      Int      @default(0)
  earnings        Decimal  @default(0) @db.Decimal(12, 2)
  distanceKm      Float    @default(0)
  onlineMinutes   Int      @default(0)
  avgDeliveryMins Float?
  offers          Int      @default(0)
  accepted        Int      @default(0)
  rejected        Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@unique([riderId, date])
  @@index([date])
  @@schema("analytics")
}

model DailySupplierStats {
  id               String   @id @default(cuid())
  date             DateTime @db.Date
  tenantId         String
  orders           Int      @default(0)
  gmv              Decimal  @default(0) @db.Decimal(14, 2)
  unitsSold        Decimal  @default(0) @db.Decimal(14, 3)
  deliveredOrders  Int      @default(0)
  onTimeDeliveries Int      @default(0)
  rejectedOrders   Int      @default(0)
  updatedAt        DateTime @updatedAt

  @@unique([tenantId, date])
  @@index([date])
  @@schema("analytics")
}

model DailyPlatformStats {
  date            DateTime @id @db.Date
  gmv             Decimal  @default(0) @db.Decimal(16, 2)
  revenue         Decimal  @default(0) @db.Decimal(16, 2)
  orders          Int      @default(0)
  cancelledOrders Int      @default(0)
  activeCustomers Int      @default(0)
  newCustomers    Int      @default(0)
  activeOutlets   Int      @default(0)
  activeRiders    Int      @default(0)
  deliveries      Int      @default(0)
  b2bOrders       Int      @default(0)
  b2bGmv          Decimal  @default(0) @db.Decimal(16, 2)
  updatedAt       DateTime @updatedAt

  @@schema("analytics")
}
