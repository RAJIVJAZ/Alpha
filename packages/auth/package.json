{
  "name": "@foodgrid/auth",
  "version": "0.1.0",
  "private": true,
  "description": "JWT issuance/verification, RBAC permission matrix, NestJS guards and Next.js session helpers.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./permissions": {
      "types": "./dist/permissions.d.ts",
      "default": "./dist/permissions.js"
    },
    "./nest": {
      "types": "./dist/nest/index.d.ts",
      "default": "./dist/nest/index.js"
    },
    "./next": "./src/next/index.ts",
    "./next/middleware": "./src/next/middleware.ts"
  },
  "typesVersions": {
    "*": {
      "permissions": [
        "dist/permissions.d.ts"
      ],
      "nest": [
        "dist/nest/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint src",
    "test": "jest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@foodgrid/types": "workspace:*",
    "jsonwebtoken": "^9.0.2"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "jose": "^6.0.0",
    "next": "^15.5.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "jose": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/testing": "^11.1.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.5",
    "typescript": "~5.9.3"
  }
}
