{
  "name": "@foodgrid/utils",
  "version": "0.1.0",
  "private": true,
  "description": "Isomorphic domain utilities (money, GST, geo, units, stats) and the NestJS service core (bootstrap, events, redis, metrics).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./testing": {
      "types": "./dist/server/testing/index.d.ts",
      "default": "./dist/server/testing/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "server": [
        "dist/server/index.d.ts"
      ],
      "testing": [
        "dist/server/testing/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "jest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@foodgrid/auth": "workspace:*",
    "@foodgrid/database": "workspace:*",
    "@foodgrid/types": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "nestjs-pino": "^4.4.0",
    "pino-http": "^10.0.0",
    "prom-client": "^15.1.0",
    "zod": "^3.24.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "@nestjs/platform-express": {
      "optional": true
    },
    "@nestjs/swagger": {
      "optional": true
    },
    "class-transformer": {
      "optional": true
    },
    "class-validator": {
      "optional": true
    },
    "helmet": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "nestjs-pino": {
      "optional": true
    },
    "pino-http": {
      "optional": true
    },
    "prom-client": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "jest": "^29.7.0",
    "nestjs-pino": "^4.4.1",
    "pino": "^9.13.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.5",
    "typescript": "~5.9.3",
    "zod": "^3.25.0"
  }
}
